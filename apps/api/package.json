{
  "name": "@movies/api",
  "version": "1.0.0",
  "private": true,
  "description": "Movies REST API - Express + DynamoDB single-table design",
  "main": "dist/src/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
